{:paths ["src" "res" "target"]
 :deps
 {com.rpl/specter                {:mvn/version "1.1.3"}
  org.clojure/math.combinatorics {:mvn/version "0.1.6"}
  org.clojure/data.json          {:mvn/version "2.5.0"}
  metosin/malli                  {:mvn/version "0.15.0"}}
 :aliases
 {:dev {:extra-paths ["dev" "test"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :exec-fn cognitect.test-runner.api/test}
  :test-free {:exec-args {:patterns ["^lp\\.test-(core|minuc|scip)$"]}}
  :test-paid {:exec-args {:patterns ["^lp\\.test-gurobi$"]}}
  :test-all {:exec-args {:patterns ["^lp\\.test-.*"]}}
  :prof {:extra-deps
         {com.clojure-goes-fast/clj-async-profiler {:mvn/version "1.3.0"}}
         :jvm-opts ["-Djdk.attach.allowAttachSelf"]}}}


